// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  usuarios  User[]
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("roles")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  nombre    String?
  roleId    Int       @map("role_id")
  role      Role      @relation(fields: [roleId], references: [id])
  isActive  Boolean   @default(true) @map("is_active")
  carritos  Carrito[]
  ordenes   Orden[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  @@map("usuarios")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?    @db.Text
  isActive    Boolean    @default(true) @map("is_active")
  productos   Producto[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  
  @@map("categorias")
}

model Producto {
  id            Int           @id @default(autoincrement())
  nombre        String
  descripcion   String?       @db.Text
  precio        Decimal       @db.Decimal(10, 2)
  stock         Int           @default(0)
  imagenUrl     String?       @map("imagen_url") @db.VarChar(500)
  isActive      Boolean       @default(true) @map("is_active")
  categoriaId   Int           @map("categoria_id")
  categoria     Categoria     @relation(fields: [categoriaId], references: [id])
  carritoItems  CarritoItem[]
  ordenItems    OrdenItem[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  
  @@index([categoriaId])
  @@map("productos")
}


model Carrito {
  id        Int           @id @default(autoincrement())
  usuarioId Int           @unique @map("usuario_id")
  usuario   User          @relation(fields: [usuarioId], references: [id])
  items     CarritoItem[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  
  @@map("carritos")
}

model CarritoItem {
  id         Int      @id @default(autoincrement())
  carritoId  Int      @map("carrito_id")
  carrito    Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  @@unique([carritoId, productoId])
  @@index([carritoId])
  @@index([productoId])
  @@map("carrito_items")
}

model Orden {
  id             Int         @id @default(autoincrement())
  numeroOrden    String      @unique @map("numero_orden")
  usuarioId      Int         @map("usuario_id")
  usuario        User        @relation(fields: [usuarioId], references: [id])
  estado         String      @default("PENDIENTE")
  subtotal       Decimal     @db.Decimal(10, 2)
  impuestos      Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  direccionEnvio String      @map("direccion_envio") @db.Text
  items          OrdenItem[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  
  @@index([usuarioId])
  @@index([estado])
  @@map("ordenes")
}

model OrdenItem {
  id             Int      @id @default(autoincrement())
  ordenId        Int      @map("orden_id")
  orden          Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  productoId     Int      @map("producto_id")
  producto       Producto @relation(fields: [productoId], references: [id])
  nombreProducto String   @map("nombre_producto")
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  cantidad       Int
  subtotal       Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  
  @@index([ordenId])
  @@index([productoId])
  @@map("orden_items")
}



